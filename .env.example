# Copy this file to .env and adjust as needed.
# Defaults below require no API key and work out of the box.

# synthetic | pdf  (pdf is the Phase 5 real-PDF swap point, not wired in by default)
LOADER_MODE=synthetic

# true | false — true uses a deterministic mock summarizer (no network, no API key)
MOCK_LLM=true

# Only used when MOCK_LLM=false
CLAUDE_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
